# Copy to .env.local for local development. The worker reads the same file.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
REGISTRATION_OPEN=true
# Quick mode only (does not limit full crawl):
MAX_SCAN_PAGES=5
OLLAMA_BASE_URL=https://ollama-qa.apps.taqat.academy
OLLAMA_MODEL=qwen2.5:1.5b
# Set only if your Ollama proxy requires Bearer authentication.
# OLLAMA_API_KEY=
NEXT_TELEMETRY_DISABLED=1

# Browser mode is attempted by default; explicit HTTP-only opt-out:
# SCAN_BROWSER=false
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
MAX_SCANS_PER_DAY=20
# AUTO_SCAN_WORKER=false disables automatic dev worker startup.

# Quick-mode duration (default60s):
MAX_SCAN_DURATION_MS=60000

# Full crawl defaults. Separate keys prevent old MAX_SCAN_PAGES=5 from capping it.
CRAWL_MAX_PAGES=5000
CRAWL_MAX_DURATION_MS=3600000
# Max supported safety caps: 10000 pages and 14400000ms (4h).

# Deep repository analysis: 1000 eligible files by default, hard cap 3000.
REPOSITORY_MAX_FILES=1000
# Optional 64 hex characters. If omitted a private key is generated under DATA_DIR.
# Preserve data/.repository-key (or this env key) with the database; do not rotate without re-linking tokens.
# REPOSITORY_ENCRYPTION_KEY=
